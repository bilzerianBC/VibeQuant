# ---- 凭据 / 密钥（模板 .example 保留，真实值一律不提交）----
.env
.env.*
!.env.example
!.env.remote.example
!.env.amazing.example
!.env.dipwatch.example
!.env.web.example
*.whl
secrets/
docker/mihomo/*
!docker/mihomo/config.example.yaml
!docker/mihomo/README.md
!docker/mihomo/.dockerignore
*.pem
*.key
*.crt

# ---- Python ----
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
.cache/
.venv/

# ---- 数据与产物（都可重新抓取 / 重新生成）----
*.csv
**/data/
**/results/
**/work/
docker/out/
*.tar
ratio_m2_gold*.html
ratio_m2_gold*.png
*.zip

# ---- 不提交的项目目录（本地保留，但不进仓库）----
# 开头的 / 只匹配仓库根目录；macOS 上 git 不区分大小写，
# 不加 / 会把 LiveMoreAmazing/livemore/ 也一起忽略掉。
/LiveMore/
/datasrc/

# ---- 系统 / 临时 / 调试残留 ----
.DS_Store
tmp/
.claude/
.codex/
.agents/
# 个人笔记 / 本机私有文件（不属于项目，不提交、不同步）
local/
