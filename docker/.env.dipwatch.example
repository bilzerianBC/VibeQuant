# Only on remote: copy to .env.dipwatch and chmod 600. Never commit real values.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_DATA_FEED=iex
# Verified US stock/ETF symbols only. Unknown original assets stay visible as errors.
DIPWATCH_SYMBOLS=QQQ,NVDA,TSLA,SPCX
# HTTP CONNECT proxy; leave blank for direct connection. HTTPS uses an http:// proxy too.
HTTP_PROXY=http://mihomo:7890
HTTPS_PROXY=http://mihomo:7890
NO_PROXY=localhost,127.0.0.1,front
