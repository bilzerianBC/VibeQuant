# Create docker/.env.amazing on the remote host. Never commit credentials.
AMAZING_USERNAME=
AMAZING_PASSWORD=
AMAZING_HOST=
AMAZING_PORT=
# Leave empty for probe.py. Set only after confirming the vendor's unit:
# shares = shares; lots = lots of 100 shares. Adapter outputs lots.
AMAZING_VOLUME_UNIT=
# Codes per query_kline/get_backward_factor call. get_backward_factor costs ~20 s per
# call almost regardless of size, so use 50 for the full universe (10 for small runs).
AMAZING_BATCH_SIZE=10
AMAZING_REQUEST_PAUSE=0.3
# Bounded retry of transient SDK errors (never of -95 permission rejections).
AMAZING_RETRIES=3
AMAZING_RETRY_WAIT=5
